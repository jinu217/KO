  speechText: {fileID: 1551665828}
  messages:
  - "\uC624\uB298\uB530\uB77C \uBC14\uB78C\uC774 \uC65C \uC774\uB807\uAC8C \uCC28\uAC11\uC9C0?"
  - "\uAD6C\uB984 \uAF34\uC744 \uBCF4\uB2C8 \uBE44\uAC00 \uD55C \uC904\uAE30 \uC624\uACA0\uC5B4."
  - "\uD587\uC0B4\uC740 \uC88B\uC740\uB370 \uB9C8\uC74C\uC740 \uCC0C\uD478\uB465\uD558\uB124."
  - "\uB0A0\uC774 \uC88B\uC544\uC11C \uADF8\uB7F0\uAC00, \uAD1C\uD788 \uB098\uB978\uD558\uAD70."
  - "\uD558\uB298\uC774 \uC65C \uC774\uB807\uAC8C \uB0AE\uAC8C \uAE54\uB824 \uC788\uC9C0?"
  message: "\uC548\uB155\uD558\uC138\uC694."
