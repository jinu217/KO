  entries:
  - menuLabel: "\uC774\uB3D9"
    title: "\uC774\uB3D9"
    titleParts: []
    screenshot: {fileID: 0}
    descriptionParts:
    - "\uBC29\uD5A5\uD0A4\uB85C \uC774\uB3D9\uC744, Space\uD0A4\uB85C \uC810\uD504\uB97C
      \uD560  \uC218 \uC788\uB2E4."
  - menuLabel: "\uD558\uAC15 \uC810\uD504 / \uAC15\uD654 \uD558\uAC15 \uC810\uD504"
    title: 
    titleParts:
    - "\uD558\uAC15 \uC810\uD504"
    - "\uAC15\uD654 \uD558\uAC15 \uC810\uD504"
    screenshot: {fileID: 0}
    descriptionParts:
    - "\uC544\uB798 \uBC29\uD5A5\uD0A4 + \uC810\uD504 \uD0A4\uB97C \uB204\uB974\uBA74
      \uD558\uAC15 \uC810\uD504\uB97C \uD560 \uC218 \uC788\uB2E4."
    - "\uC544\uB798 \uBC29\uD5A5\uD0A4 + \uC810\uD504 \uD0A4 + \uC544\uB798 \uBC29\uD5A5\uD0A4\uB97C
      \uB204\uB974\uBA74 \uAC15\uD654 \uD558\uAC15 \uC810\uD504\uB97C \uD560 \uC218
      \uC788\uB2E4."
  - menuLabel: "\uB300\uC26C"
    title: "\uB300\uC26C"
    titleParts: []
    screenshot: {fileID: 0}
    descriptionParts:
    - "S\uD0A4\uB85C \uC801\uC758 \uACF5\uACA9\uC744 \uD68C\uD53C\uD558\uACE0 \uBE60\uB974\uAC8C
      \uC804\uBC29\uC73C\uB85C \uC774\uB3D9\uD55C\uB2E4."
  - menuLabel: "\uC0C1\uD638\uC791\uC6A9"
    title: 
    titleParts:
    - "\uC0C1\uD638\uC791\uC6A9"
    - "\uBCF4\uBB3C\uC0C1\uC790"
    screenshot: {fileID: 0}
    descriptionParts:
    - "F\uD0A4\uB85C \uAC01\uC885 \uC0C1\uD638\uC791\uC6A9\uC744 \uD560 \uC218 \uC788\uB2E4."
    - "\uBCF4\uBB3C\uC0C1\uC790\uB294 \uC88C\uC6B0 \uBC29\uD5A5\uD0A4\uB85C \uC544\uC774\uD15C\uC744
      \uC120\uD0DD \uD6C4 F\uD0A4\uB85C \uD655\uC815 \uC9C0\uC744 \uC218 \uC788\uB2E4."
  - menuLabel: "\uC778\uBCA4\uD1A0\uB9AC"
    title: "\uC778\uBCA4\uD1A0\uB9AC"
    titleParts: []
    screenshot: {fileID: 0}
    descriptionParts:
    - "E\uD0A4\uB85C \uC778\uBCA4\uD1A0\uB9AC\uB97C \uC5F4 \uC218 \uC788\uB2E4. F\uD0A4\uB85C
      \uC544\uC774\uD15C \uC7A5\uCC29, S\uD0A4\uB85C \uC544\uC774\uD15C \uBC84\uB9AC\uAE30\uAC00
      \uAC00\uB2A5\uD558\uB2E4."
  - menuLabel: "\uACF5\uACA9"
    title: 
    titleParts: []
    screenshot: {fileID: 0}
    descriptionParts:
    - "D\uD0A4\uB85C \uACF5\uACA9\uD560 \uC218 \uC788\uB2E4."
  - menuLabel: HP / SP / BPM
    title: 
    titleParts:
    - HP
    - SP
    - BPM
    screenshot: {fileID: 0}
    descriptionParts:
    - "\uC801\uC5D0\uAC8C \uACF5\uACA9 \uB2F9\uD558\uBA74 HP\uAC00 \uAC10\uC18C\uD55C\uB2E4.
      Q\uD0A4\uB85C HP \uD3EC\uC158\uC744 \uC0AC\uC6A9\uD558\uBA74 \uBE60\uB974\uAC8C
      \uD68C\uBCF5\uD560 \uC218 \uC788\uB2E4."
    - "\uB300\uC26C\uB97C \uC0AC\uC6A9\uD558\uBA74 SP\uAC00 \uAC10\uC18C\uD55C\uB2E4.
      \uC801\uC744 \uACF5\uACA9\uD558\uBA74 SP\uB97C \uD68C\uBCF5\uD55C\uB2E4."
    - "\uB300\uC26C\uB97C \uC0AC\uC6A9\uD558\uAC70\uB098 \uACF5\uACA9\uD558\uBA74
      BPM\uC774 \uC0C1\uC2B9\uD55C\uB2E4."
    - "BPM\uC774 \uB192\uC544\uC9C0\uBA74 \uAC01\uC885 \uBC84\uD504\uB97C \uBC1B\uC744
      \uC218 \uC788\uB2E4. \uD558\uC9C0\uB9CC \uB108\uBB34 \uB192\uC544\uC9C0\uBA74
      \uB514\uBC84\uD504\uB97C \uBC1B\uB294\uB2E4. "
    - "F\uD0A4\uB97C \uB204\uB974\uB294 \uB3D9\uC548 \uBA85\uC0C1\uC744 \uD558\uAC70\uB098
      W\uD0A4\uB85C BPM \uD3EC\uC158\uC744 \uC0AC\uC6A9\uD558\uBA74 BPM\uC774 \uC77C\uC815
      \uC218\uCE58\uB9CC\uD07C \uAC10\uC18C\uD55C\uB2E4."
