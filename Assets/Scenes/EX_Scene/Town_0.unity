  - "\uB178\uB798\uB098 \uD55C \uAC00\uB77D \uD765\uC5BC\uAC70\uB824 \uBCFC\uAE4C\uB098~"
  - "\uC624\uB298\uB530\uB77C \uB9C8\uC744 \uBC16\uC774 \uC2DC\uB044\uB7FD\uB124.."
  - "\uC2E0\uBC1C\uB048\uC774 \uD480\uB838\uC5C8\uB124, \uB2E4\uC2DC \uBB36\uC5B4\uC57C\uACA0\uC5B4."
  message: "\uC548\uB155\uD558\uC138\uC694."
